# Server Port
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gaze_detection?retryWrites=true&w=majority

# Strong JWT Secret for Token Signing
JWT_SECRET=your_jwt_secret_key_here

# Gaze Detection Model API (Hugging Face Space)
GAZE_API_BASE_URL=https://ah-freak-gaze-detection-api.hf.space
GAZE_API_KEY=
GAZE_API_TIMEOUT_MS=30000
GAZE_API_RETRY_COUNT=2
GAZE_API_H_THRESH=0.12
GAZE_API_V_THRESH=0.10

# Local SQLite Database for Audit & Raw Predictions
SQLITE_DB_PATH=./sqlite-data/gaze_results.sqlite
